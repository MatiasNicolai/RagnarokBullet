# Generated by tools/slice-thanatos.py, slice-bosses-v3.py and slice-mobs-v3.py. Each QA report pins their sha256 and
# server/test-static.mjs checks it, so line endings must stay byte-exact on
# every checkout (no autocrlf rewriting).
public/assets-v2/thanatos/*.json -text
art-clean/thanatos-gpt/qa/report-thanatos.json -text
public/assets-v2/bosses-v3/*.json -text
art-clean/bosses-v3-gpt/qa/report-bosses-v3.json -text
public/assets-v2/mobs-v3/*.json -text
art-clean/mobs-v3-gpt/qa/report-mobs-v3.json -text
# Shell scripts run under Git Bash, which chokes on CRLF.
*.sh text eol=lf
